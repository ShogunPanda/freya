#!/usr/bin/env node

import { fileURLToPath } from 'node:url'
import { launch } from '@perseveranza-pets/dante/launcher'

try {
  await launch({
    cli: new URL('../dist/cli.js', import.meta.url),
    build: new URL('../dist/build.js', import.meta.url),
    server: new URL('../dist/server.js', import.meta.url),
    skills: {
      default: 'freya',
      files: {
        freya: fileURLToPath(new URL('../SKILL.md', import.meta.url))
      }
    }
  })
} catch (error) {
  console.error(error)
  process.exitCode = 1
}

{
  "name": "@perseveranza-pets/freya",
  "version": "1.1.0",
  "description": "Opinionated JSX based slides generator.",
  "homepage": "https://sw.cowtech.it/freya",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShogunPanda/freya.git"
  },
  "keywords": [
    "slides"
  ],
  "bugs": {
    "url": "https://github.com/ShogunPanda/freya/issues"
  },
  "author": "Shogun <shogun@cowtech.it>",
  "license": "ISC",
  "private": false,
  "bin": {
    "freya": "bin/freya",
    "create-freya-slideset": "bin/create-freya-slideset"
  },
  "files": [
    "bin",
    "dist",
    "CHANGELOG.md",
    "LICENSE.md",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.js"
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "dev": "rm -rf dist && tsc -p tsconfig.json && cp -a src/assets dist",
    "build": "rm -rf dist && tsc -p tsconfig.json && cp -a src/assets dist && npm run lint && npm run lint:css",
    "format": "prettier -w src",
    "lint": "eslint --cache",
    "lint:css": "stylelint --cache src/**/*.css",
    "test": "exit 0",
    "ci": "npm run build && npm run test",
    "prepublishOnly": "npm run ci",
    "postpublish": "git push origin && git push origin -f --tags"
  },
  "dependencies": {
    "@fastify/formbody": "^9.0.0",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@perseveranza-pets/dante": "^2.1.0",
    "commander": "^15.0.0",
    "fastify": "^5.12.5",
    "glob": "^13.0.6",
    "http-errors-enhanced": "^4.0.2",
    "js-yaml": "^5.4.2",
    "jszip": "^3.10.2",
    "markdown-it": "^15.0.2",
    "pdfkit": "^0.20.2",
    "pino": "^10.3.1",
    "playwright": "^1.63.0",
    "playwright-chromium": "^1.63.0",
    "pptxgenjs": "^4.0.1",
    "preact": "^11.0.0",
    "preact-render-to-string": "^6.7.0",
    "preact-router": "^4.1.2",
    "pusher-js": "8.6.0",
    "qrcode-generator": "^2.0.4",
    "rolldown": "1.2.12",
    "wait-on": "^9.5.1",
    "xml-js": "^1.6.11"
  },
  "devDependencies": {
    "@cowtech/eslint-config": "^11.1.3",
    "@cowtech/stylelint-config": "^2.0.5",
    "@cowtech/typescript-config": "^0.2.7",
    "@eslint/compat": "^2.1.1",
    "@types/js-yaml": "^4.0.9",
    "@types/markdown-it": "^14.2.0",
    "@types/pdfkit": "^0.17.6",
    "@types/wait-on": "^5.3.4",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.11.0",
    "lightningcss": "^1.33.0",
    "prettier": "^3.9.9",
    "stylelint": "^17.15.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
}
